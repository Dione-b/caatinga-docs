---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Deployment orchestration and versioned artifacts for Soroban." } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Caatinga</title>
  </head>
  <body
    class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100"
  >
    <slot />
  </body>
</html>
