---
import Layout from "@layouts/Layout.astro";
import Sidebar from "@components/Sidebar.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import PrevNext from "@components/PrevNext.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings?: Heading[];
}

const { title, description, headings = [] } = Astro.props as Props;
---

<Layout title={title} description={description}>
  <div class="mx-auto flex w-full max-w-[105rem] gap-6 lg:gap-8 px-4 sm:px-6 md:px-8">
    <Sidebar />
    <div class="min-w-0 flex-1 py-6 sm:py-10 max-w-full">
      <Breadcrumb />
      <TableOfContents headings={headings} variant="mobile" />
      <article class="docs-content flex flex-col gap-4 max-w-full">
        <slot />
      </article>
      <PrevNext />
    </div>
    <TableOfContents headings={headings} variant="desktop" />
  </div>
</Layout>
