---
interface Props {
  block?: boolean;
  class?: string;
}

const { block = false, class: className } = Astro.props as Props;
---

{
  block ? (
    <pre
      class:list={[
        "overflow-x-auto rounded-md border border-border bg-surface p-4 text-sm",
        className,
      ]}
    >
      <code class="font-mono">
        <slot />
      </code>
    </pre>
  ) : (
    <code
      class:list={[
        "rounded-sm border border-border bg-surface px-1.5 py-0.5 text-[0.85em] font-mono text-ink",
        className,
      ]}
    >
      <slot />
    </code>
  )
}
