---
interface Props {
  prompt?: string;
  class?: string;
}

const { prompt = "$", class: className } = Astro.props as Props;
---

<div
  class:list={[
    "flex items-center gap-2 rounded-md border border-border bg-surface px-4 py-2.5 font-mono text-sm",
    className,
  ]}
>
  <span class="text-muted select-none" aria-hidden="true">{prompt}</span>
  <code class="text-ink">
    <slot />
  </code>
</div>
