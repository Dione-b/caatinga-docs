---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  class?: string;
}

const { href, class: className, ...rest } = Astro.props as Props;

const base = import.meta.env.BASE_URL;
const isRootRelative = href.startsWith("/") && !href.startsWith("//");
const isAlreadyPrefixed = isRootRelative && href.startsWith(base);
const resolvedHref = isRootRelative && !isAlreadyPrefixed ? base + href.slice(1) : href;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={resolvedHref}
  class:list={["text-primary underline underline-offset-2 hover:text-primary-hover", className]}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  {...rest}
>
  <slot />
  {
    isExternal && (
      <Icon name="lucide:arrow-up-right" class="inline size-3 align-[-0.15em]" aria-hidden="true" />
    )
  }
</a>
