---
import { Icon } from "astro-icon/components";
import { resolveHref } from "@/lib/url";

interface Props {
  href: string;
  class?: string;
}

const { href, class: className, ...rest } = Astro.props as Props;

const resolvedHref = resolveHref(href);
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={resolvedHref}
  class:list={["text-primary underline underline-offset-2 hover:text-primary-hover", className]}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  {...rest}
>
  <slot />
  {
    isExternal && (
      <Icon name="lucide:arrow-up-right" class="inline size-3 align-[-0.15em]" aria-hidden="true" />
    )
  }
</a>
