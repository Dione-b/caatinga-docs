---
import NavList from "@components/NavList.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---

<aside
  class:list={[
    "sticky top-16 hidden h-[calc(100vh-4rem)] w-64 shrink-0 overflow-y-auto py-8 pr-4 lg:block",
    className,
  ]}
>
  <NavList />
</aside>
