---
interface Props {
  size?: "sm" | "md" | "lg" | "xl" | "full";
  class?: string;
}

const { size = "lg", class: className } = Astro.props as Props;

const widths: Record<NonNullable<Props["size"]>, string> = {
  sm: "max-w-2xl",
  md: "max-w-3xl",
  lg: "max-w-5xl",
  xl: "max-w-[90rem]",
  full: "max-w-none",
};
---

<div class:list={["mx-auto w-full px-6", widths[size], className]}>
  <slot />
</div>
