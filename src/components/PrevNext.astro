---
import { getPrevNext } from "@/lib/docs-nav";
import { resolveHref } from "@/lib/url";
import { Icon } from "astro-icon/components";

const { prev, next } = await getPrevNext(Astro.url.pathname);
---

{
  (prev || next) && (
    <nav
      aria-label="Page navigation"
      class="mt-12 flex items-center justify-between gap-4 border-t border-border pt-6"
    >
      <div>
        {prev && (
          <a href={resolveHref(prev.href)} class="group flex flex-col gap-1 text-sm">
            <span class="flex items-center gap-1 text-muted">
              <Icon name="lucide:arrow-left" class="size-3.5" aria-hidden="true" />
              Previous
            </span>
            <span class="font-medium text-ink group-hover:text-primary">{prev.title}</span>
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={resolveHref(next.href)} class="group flex flex-col items-end gap-1 text-sm">
            <span class="flex items-center gap-1 text-muted">
              Next
              <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
            </span>
            <span class="font-medium text-ink group-hover:text-primary">{next.title}</span>
          </a>
        )}
      </div>
    </nav>
  )
}
