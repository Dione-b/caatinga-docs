---
import { resolveHref } from "@/lib/url";

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className, ...rest } = Astro.props as Props;
const Tag = href ? "a" : "div";
const resolvedHref = href ? resolveHref(href) : undefined;

const classes = [
  "block rounded-md border border-border bg-surface p-5",
  href && "transition-colors hover:border-primary",
  className,
];
---

<Tag href={resolvedHref} class:list={classes} {...rest}>
  <slot />
</Tag>
