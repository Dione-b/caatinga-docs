---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Button from "@components/Button.astro";
---

<Layout title="Home">
  <Container size="md">
    <main class="flex flex-col gap-6 py-24">
      <p class="text-sm font-medium tracking-wide text-muted uppercase">Caatinga</p>
      <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Deployment orchestration<br />for Soroban.
      </h1>
      <p class="max-w-xl text-lg text-muted">Build. Deploy. Version. Interact.</p>
      <div class="flex gap-4">
        <Button variant="primary" href="/docs">Get Started</Button>
        <Button variant="secondary" href="https://github.com/Dione-b/caatinga">GitHub</Button>
      </div>
    </main>
  </Container>
</Layout>
