---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404">
  <main class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-24 text-center">
    <h1 class="text-3xl font-bold tracking-tight">404</h1>
    <p class="text-neutral-600 dark:text-neutral-400">This page doesn't exist.</p>
    <a href={import.meta.env.BASE_URL} class="underline">Back home</a>
  </main>
</Layout>
